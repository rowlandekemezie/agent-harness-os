# Model-agnostic worker registry. Keep secrets in the referenced environment variables.
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
GEMINI_API_KEY=replace-me
OPENROUTER_API_KEY=replace-me
QWEN_API_KEY=replace-me

# Default example: reuse `codex login` / ChatGPT subscription authentication.
# No OPENAI_API_KEY is required for this worker.
AGENT_OS_WORKERS_JSON=[{"id":"codex-subscription","adapter":"codex","capabilities":["research","implementation","testing","review","tool-calling","long-context"],"priority":100,"costTier":"low","latencyTier":"standard"}]
# Optional role profiles; see examples/profiles.json. When set, defaults and
# route preferences use profile IDs rather than backing worker IDs.
AGENT_OS_WORKER_PROFILES_JSON=
AGENT_OS_DEFAULT_WORKER=codex-subscription
AGENT_OS_ROUTING_STRATEGY=balanced
AGENT_OS_MAX_WORKER_ATTEMPTS=3
# Recent same-mode tasks used for deterministic measured routing; 0 disables.
AGENT_OS_ROUTING_EVIDENCE_TASK_LIMIT=100
# Optional absolute path to a host-managed organization policy. Repositories
# may also commit .agent-os/policy.json at the delegated base commit.
AGENT_OS_ORGANIZATION_POLICY_PATH=

# Legacy single-Qwen configuration remains supported when AGENT_OS_WORKERS_JSON is unset.
QWEN_BASE_URL=
QWEN_CHAT_COMPLETIONS_URL=
QWEN_MODEL=
QWEN_HEADERS_JSON={}
QWEN_TIMEOUT_MS=120000
QWEN_MAX_RETRIES=3
QWEN_MAX_RESPONSE_BYTES=4194304
QWEN_ALLOW_INSECURE_HTTP=false

# Harness safety and runtime settings
AGENT_HARNESS_EXECUTION_BACKEND=local
AGENT_HARNESS_ALLOW_UNSANDBOXED_LOCAL=false
AGENT_HARNESS_DOCKER_IMAGE=node:22-bookworm-slim@sha256:<replace-with-64-hex-digest>
AGENT_HARNESS_REQUIRE_PINNED_DOCKER_IMAGE=true
AGENT_HARNESS_DOCKER_NETWORK=none
AGENT_HARNESS_MAX_CONCURRENCY=1
AGENT_HARNESS_MAX_FILE_BYTES=1048576
AGENT_HARNESS_MAX_TOOL_OUTPUT_BYTES=65536
AGENT_HARNESS_MAX_MCP_MESSAGE_BYTES=1048576
AGENT_HARNESS_MAX_MCP_IN_FLIGHT=64
AGENT_HARNESS_MAX_CHANGED_FILES=200
AGENT_HARNESS_MAX_SEARCH_BYTES=33554432
AGENT_HARNESS_MAX_TRAVERSAL_ENTRIES=10000
AGENT_HARNESS_MAX_TOTAL_TOOL_CALLS=128
AGENT_HARNESS_MAX_PROVIDER_CONTEXT_BYTES=8388608
AGENT_HARNESS_COMMAND_TIMEOUT_MS=120000
AGENT_HARNESS_ALLOWED_COMMANDS=npm,pnpm,yarn,bun,tsc,vitest,jest,eslint,prettier,biome
AGENT_HARNESS_ARTIFACT_ROOT=
AGENT_HARNESS_LOG_LEVEL=info
